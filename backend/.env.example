PORT=5000
NODE_ENV=production

# PostgreSQL — update with your Neon.tech connection string
DATABASE_URL=postgresql://hydrogen_user:hydrogen_password@localhost:5432/hydrogen_pipeline

# Redis — update with your Upstash Redis URL
REDIS_URL=redis://localhost:6379

# JWT Secret — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_in_production
